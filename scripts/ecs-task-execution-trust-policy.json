{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Service": "ecs-tasks.amazonaws.com"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:SourceAccount": "609941781976"
        },
        "ArnLike": {
          "aws:SourceArn": [
            "arn:aws:ecs:sa-east-1:609941781976:*",
            "arn:aws:ecs:us-east-1:609941781976:*"
          ]
        }
      }
    }
  ]
}
