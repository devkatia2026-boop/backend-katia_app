{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadIntroductionContents",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::katia-app-uploads/introduction-contents/*"
    },
    {
      "Sid": "PublicReadWellsMedia",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::katia-app-uploads/wells/*"
    }
  ]
}
